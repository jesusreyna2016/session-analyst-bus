# --- MFP ---
# Key de prueba (Settings > API Keys > Test (Sandbox)). Empieza con fp_test_
MFP_API_KEY=fp_test_xxx
MFP_API_BASE=https://sandbox.myfundedperpetuals.com
# Vacio = la primera cuenta activa. Acepta el id o el numero (FP-...)
MFP_ACCOUNT_ID=
# Para apuntar a una cuenta real hay que cambiar MFP_API_BASE y poner ALLOW_LIVE=1 a proposito
ALLOW_LIVE=0

# --- Riesgo (imita la cuenta real: 100K, DLL 3% = 3000, drawdown 3000) ---
RISK_USD=300
DLL_USD=3000
DAY_STOP_PCT=0.9
MAX_DD_USD=3000
MAX_CONCURRENT=5
# 0 = sin limite de entradas por dia
MAX_ENTRIES_PER_DAY=0

# --- Zonas ---
GRADES=A+,A
MIN_RR=1
MAX_DIST_ATR5=6
MAX_FEED_AGE_MIN=5
REQUIRE_OPERABLE=1

# --- Diferencia perp - futuro ---
BASIS_MIN_SAMPLES=3
BASIS_WINDOW=8
BASIS_MAX_SPREAD_R=0.2

# --- Ordenes ---
GTD_MIN=30
RENEW_MIN=10

# Mercado de MFP para cada simbolo de Mi Mesa
# MARKETS={"NQ":"ostium|NDX","ES":"ostium|SP500","GC":"binance|XAUUSDT","ETHUSDT":"binance|ETHUSDT","BTCUSDT":"binance|BTCUSDT"}

# --- Bitacora ---
DATA_DIR=./data
PORT=8080
# Opcional: copia la bitacora y los reportes al bus de GitHub (token fine-grained con Contents: write en ese repo)
GH_TOKEN=
GH_REPO=jesusreyna2016/session-analyst-bus
GH_BRANCH=main
GH_DIR=mfp/bot-data

# 1 = calcula todo pero no manda ordenes
DRY_RUN=0
